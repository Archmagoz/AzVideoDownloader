<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <!-- ==================================================== -->
        <!--  FONT FAMILY                                         -->
        <!-- ==================================================== -->

        <!-- The ONLY font used anywhere in the app: Roboto SemiBold,
         referenced by its exact file (not the /Fonts folder), so WPF
         can never resolve to any other Roboto weight sharing the same
         internal family name. No fallback family, no weight switching -
         every style below points to this single resource. -->
        <FontFamily x:Key="AppFontFamily">pack://application:,,,/Fonts/Roboto-SemiBold.ttf#Roboto SemiBold</FontFamily>

        <!-- ==================================================== -->
        <!--  TYPOGRAPHY SCALE                                    -->
        <!--  Consistent sizing hierarchy for headings, body text -->
        <!--  and captions. Based on a modular scale for visual   -->
        <!--  rhythm across the app.                              -->
        <!-- ==================================================== -->

        <!-- Page / screen titles -->
        <sys:Double x:Key="FontSizeHeading1"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">28</sys:Double>

        <!-- Section titles -->
        <sys:Double x:Key="FontSizeHeading2"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>

        <!-- Card / subsection titles -->
        <sys:Double x:Key="FontSizeHeading3"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>

        <!-- Default body text -->
        <sys:Double x:Key="FontSizeBody"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>

        <!-- Secondary / helper text -->
        <sys:Double x:Key="FontSizeCaption"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>

        <!-- ==================================================== -->
        <!--  TEXT STYLES                                         -->
        <!--  Ready-to-use styles built on top of the scale above -->
        <!--  Apply directly to TextBlock elements for consistency-->
        <!--  All of them use AppFontFamily and leave FontWeight   -->
        <!--  at Normal, since the SemiBold weight is already      -->
        <!--  baked into this font file's glyphs - setting a       -->
        <!--  heavier FontWeight on top would make WPF synthesize  -->
        <!--  a "faux bold" layer over an already-bold face.       -->
        <!-- ==================================================== -->

        <Style x:Key="AppHeading1"
               TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamily}"/>
                <Setter Property="FontSize"
                        Value="{StaticResource FontSizeHeading1}"/>
                <Setter Property="TextWrapping"
                        Value="Wrap"/>
        </Style>

        <Style x:Key="AppHeading2"
               TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamily}"/>
                <Setter Property="FontSize"
                        Value="{StaticResource FontSizeHeading2}"/>
                <Setter Property="TextWrapping"
                        Value="Wrap"/>
        </Style>

        <Style x:Key="AppBodyText"
               TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamily}"/>
                <Setter Property="FontSize"
                        Value="{StaticResource FontSizeBody}"/>
                <Setter Property="TextWrapping"
                        Value="Wrap"/>
                <Setter Property="LineHeight"
                        Value="20"/>
        </Style>

        <Style x:Key="AppCaptionText"
               TargetType="TextBlock">
                <Setter Property="FontFamily"
                        Value="{StaticResource AppFontFamily}"/>
                <Setter Property="FontSize"
                        Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource MaterialDesignBodyLight}"/>
                <Setter Property="TextWrapping"
                        Value="Wrap"/>
        </Style>

</ResourceDictionary>
