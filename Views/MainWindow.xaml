<Window x:Class="AzVideoDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Az Video Downloader"
        Icon="/icon.ico"
        Width="1280"
        Height="800"
        MinWidth="1280"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================================================== -->
        <!--  TOP BAR: URL input, settings, and output directory  -->
        <!-- ==================================================== -->
        <materialDesign:Card Grid.Row="0"
                             Style="{StaticResource AppCard}"
                             Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Video URL input and clipboard shortcut.
                     Disabled as a group while a download is running (see SetDownloadingState). -->
                <Grid x:Name="LinkInputPanel"
                      Grid.Column="0">
                    <!-- TextChanged arms the debounce; Pasting triggers an immediate metadata fetch. -->
                    <TextBox x:Name="InputLink"
                             Style="{StaticResource AppTextBox}"
                             materialDesign:HintAssist.Hint="Cole o link do vídeo aqui"
                             materialDesign:TextFieldAssist.PrefixText="🔗"
                             Margin="44,0,0,0"
                             TextChanged="InputLink_TextChanged"
                             DataObject.Pasting="InputLink_Pasting"/>

                    <!-- Pastes the clipboard text into the URL input. -->
                    <Button x:Name="PasteLinkButton"
                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            ToolTip="Colar da área de transferência"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="-6,0,0,0"
                            Click="PasteLinkButton_Click">
                        <materialDesign:PackIcon Kind="ContentPaste"
                                                 Width="18"
                                                 Height="18"/>
                    </Button>
                </Grid>

                <!-- Opens the application settings window. -->
                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Style="{StaticResource MaterialDesignFloatingActionButton}"
                        ToolTip="Configurações"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="SettingsButton_Click">
                    <materialDesign:PackIcon Kind="Cog"
                                             Width="18"
                                             Height="18"/>
                </Button>

                <!-- Output directory selector and recent directory history.
                     Disabled as a group while a download is running (see SetDownloadingState). -->
                <Grid x:Name="OutputDirPanel"
                      Grid.Column="2"
                      Margin="0,0,-8,0">
                    <ComboBox x:Name="OutputDir"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              IsEditable="False"
                              materialDesign:HintAssist.Hint="Pasta de saída"
                              materialDesign:TextFieldAssist.PrefixText="📁"
                              Margin="0,0,52,0"
                              SelectionChanged="OutputDir_SelectionChanged"/>

                    <!-- Opens the folder selection dialog. -->
                    <Button x:Name="BrowseOutputButton"
                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            ToolTip="Selecionar pasta"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Click="BrowseOutputButton_Click">
                        <materialDesign:PackIcon Kind="FolderOpen"
                                                 Width="18"
                                                 Height="18"/>
                    </Button>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <!-- ==================================================== -->
        <!--  BODY: format selection, download options, and info  -->
        <!-- ==================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- ============== COLUMN 1: FORMAT SELECTION ============== -->
            <!-- The card is disabled while a download is running. IsEnabled is inherited, so
                 a list disabled on its own (e.g. video list in audio-only mode) stays
                 disabled after the card is enabled again. -->
            <materialDesign:Card x:Name="FormatSelectionCard"
                                 Grid.Column="0"
                                 Style="{StaticResource AppCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource AppHeading2}"
                               Text="FORMATO DE VÍDEO"
                               Margin="0,0,0,8"/>

                    <!-- Populated in code-behind after the available video formats are fetched. -->
                    <Grid Grid.Row="1"
                          Margin="0,0,0,16">
                        <ListBox x:Name="VideoFormatListBox"
                                 DisplayMemberPath="Display"
                                 SelectionMode="Single"
                                 materialDesign:ListBoxItemAssist.ShowSelection="True"
                                 SelectionChanged="VideoFormatListBox_SelectionChanged"/>

                        <ProgressBar x:Name="VideoFormatsLoadingIndicator"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True"
                                     Width="32"
                                     Height="32"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"/>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Style="{StaticResource AppHeading2}"
                               Text="FORMATO DE ÁUDIO"
                               Margin="0,0,0,8"/>

                    <!-- Populated in code-behind after the available audio formats are fetched. -->
                    <Grid Grid.Row="3">
                        <ListBox x:Name="AudioFormatListBox"
                                 DisplayMemberPath="Display"
                                 SelectionMode="Single"
                                 materialDesign:ListBoxItemAssist.ShowSelection="True"/>

                        <ProgressBar x:Name="AudioFormatsLoadingIndicator"
                                     Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True"
                                     Width="32"
                                     Height="32"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- ============== COLUMN 2: DOWNLOAD OPTIONS ============== -->
            <materialDesign:Card Grid.Column="2"
                                 Style="{StaticResource AppCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource AppHeading2}"
                               Text="OPÇÕES"
                               Margin="0,0,0,12"/>

                    <!-- Keeps the options area scrollable while the Download button
                         remains pinned below it. -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- Options below are mapped to YtDlpOptions in code-behind. -->
                            <CheckBox x:Name="AudioOnlyCheckBox"
                                      Content="Somente áudio (extrair)"
                                      FontFamily="Roboto SemiBold"
                                      Margin="0,0,0,10"
                                      Checked="AudioOnlyCheckBox_Checked"
                                      Unchecked="AudioOnlyCheckBox_Unchecked"/>

                            <CheckBox x:Name="MergeAudioVideoCheckBox"
                                      Content="Mesclar vídeo + áudio"
                                      IsChecked="True"
                                      FontFamily="Roboto SemiBold"
                                      Margin="0,0,0,10"/>

                            <CheckBox x:Name="EmbedThumbnailCheckBox"
                                      Content="Incorporar thumbnail"
                                      IsChecked="True"
                                      FontFamily="Roboto SemiBold"
                                      Margin="0,0,0,10"/>

                            <CheckBox x:Name="EmbedMetadataCheckBox"
                                      Content="Incorporar metadados"
                                      IsChecked="True"
                                      FontFamily="Roboto SemiBold"
                                      Margin="0,0,0,10"/>

                            <CheckBox x:Name="EmbedSubtitlesCheckBox"
                                      Content="Incorporar legendas (se houver)"
                                      FontFamily="Roboto SemiBold"
                                      Margin="0,0,0,10"/>

                            <CheckBox x:Name="DownloadPartialCheckBox"
                                      Content="Baixar apenas um trecho"
                                      FontFamily="Roboto SemiBold"
                                      Margin="0,0,0,10"/>

                            <!-- Start and end timestamps for partial downloads.
                                 Visibility is bound to DownloadPartialCheckBox. -->
                            <Grid Margin="0,0,0,10">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=DownloadPartialCheckBox}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource AppCaptionText}"
                                           Text="De:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>

                                <TextBox x:Name="DownloadStartTextBox"
                                         Grid.Column="1"
                                         Style="{StaticResource AppTextBox}"
                                         materialDesign:HintAssist.Hint="HH:MM:SS"
                                         Text="00:00:00"
                                         GotFocus="DownloadTimestampTextBox_GotFocus"
                                         PreviewTextInput="DownloadTimestampTextBox_PreviewTextInput"
                                         PreviewKeyDown="DownloadTimestampTextBox_PreviewKeyDown"
                                         DataObject.Pasting="DownloadTimestampTextBox_Pasting"/>

                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource AppCaptionText}"
                                           Text="Até:"
                                           VerticalAlignment="Center"
                                           Margin="12,0,8,0"/>

                                <TextBox x:Name="DownloadEndTextBox"
                                         Grid.Column="3"
                                         Style="{StaticResource AppTextBox}"
                                         materialDesign:HintAssist.Hint="HH:MM:SS"
                                         Text="00:00:00"
                                         GotFocus="DownloadTimestampTextBox_GotFocus"
                                         PreviewTextInput="DownloadTimestampTextBox_PreviewTextInput"
                                         PreviewKeyDown="DownloadTimestampTextBox_PreviewKeyDown"
                                         DataObject.Pasting="DownloadTimestampTextBox_Pasting"/>
                            </Grid>

                            <Separator Margin="0,4,0,14"/>

                            <CheckBox x:Name="ChangeExtensionCheckBox"
                                      Content="Alterar extensão de saída"
                                      IsChecked="True"
                                      FontFamily="Roboto SemiBold"
                                      Margin="0,0,0,8"/>

                            <!-- Items are replaced in code-behind according to the download mode. -->
                            <ComboBox x:Name="ChangeExtensionComboBox"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      IsEnabled="{Binding IsChecked, ElementName=ChangeExtensionCheckBox}"
                                      materialDesign:HintAssist.Hint="Container de saída"
                                      FontFamily="Roboto SemiBold"
                                      Margin="0,0,0,10">
                                <ComboBoxItem Content="mp4"
                                              IsSelected="True"/>
                                <ComboBoxItem Content="mkv"/>
                                <ComboBoxItem Content="mov"/>
                                <ComboBoxItem Content="webm"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Doubles as the cancel button: code-behind sets Tag="Downloading"
                         while a download is running, which triggers the red "CANCELAR" state. -->
                    <Button x:Name="DownloadButton"
                            Grid.Row="2"
                            Height="50"
                            Margin="0,18,0,0"
                            Click="DownloadButton_Click">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content"
                                        Value="BAIXAR"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                                 Value="Downloading">
                                        <Setter Property="Content"
                                                Value="CANCELAR"/>
                                        <Setter Property="Background"
                                                Value="#D32F2F"/>
                                        <Setter Property="BorderBrush"
                                                Value="#D32F2F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </materialDesign:Card>

            <!-- ============== COLUMN 3: PREVIEW + VIDEO INFO ============== -->
            <materialDesign:Card Grid.Column="4"
                                 Style="{StaticResource AppCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Thumbnail of the current video. -->
                        <Border Height="340"
                                CornerRadius="8"
                                Background="{DynamicResource MaterialDesignDivider}"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="ThumbPreview"
                                       Stretch="Uniform"/>

                                <TextBlock x:Name="ThumbPlaceholderText"
                                           Style="{StaticResource AppCaptionText}"
                                           Text="Pré-visualização"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Metadata of the current video. -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource AppHeading2}"
                                       Text="INFORMAÇÕES DO VÍDEO"
                                       Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.Resources>
                                    <Style x:Key="InfoLabel"
                                           TargetType="TextBlock"
                                           BasedOn="{StaticResource AppCaptionText}">
                                        <Setter Property="Margin"
                                                Value="0,0,0,4"/>
                                    </Style>

                                    <Style x:Key="InfoValue"
                                           TargetType="TextBlock"
                                           BasedOn="{StaticResource AppBodyText}">
                                        <Setter Property="Margin"
                                                Value="0,0,0,4"/>
                                    </Style>
                                </Grid.Resources>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Style="{StaticResource InfoLabel}"
                                           Text="Título:"/>
                                <TextBlock x:Name="VideoTitleText"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Style="{StaticResource InfoValue}"
                                           Text="—"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Style="{StaticResource InfoLabel}"
                                           Text="Duração:"/>
                                <TextBlock x:Name="VideoDurationText"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Style="{StaticResource InfoValue}"
                                           Text="—"/>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Style="{StaticResource InfoLabel}"
                                           Text="FPS:"/>
                                <TextBlock x:Name="VideoFpsText"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Style="{StaticResource InfoValue}"
                                           Text="—"/>

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Style="{StaticResource InfoLabel}"
                                           Text="Bitrate:"/>
                                <TextBlock x:Name="VideoBitrateText"
                                           Grid.Row="3"
                                           Grid.Column="1"
                                           Style="{StaticResource InfoValue}"
                                           Text="—"/>

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Style="{StaticResource InfoLabel}"
                                           Text="Resolução:"/>
                                <TextBlock x:Name="VideoResolutionText"
                                           Grid.Row="4"
                                           Grid.Column="1"
                                           Style="{StaticResource InfoValue}"
                                           Text="—"/>

                                <!-- Last row has no bottom margin. -->
                                <TextBlock Grid.Row="5"
                                           Grid.Column="0"
                                           Style="{StaticResource InfoLabel}"
                                           Text="Tamanho:"
                                           Margin="0"/>
                                <TextBlock x:Name="VideoSizeText"
                                           Grid.Row="5"
                                           Grid.Column="1"
                                           Style="{StaticResource InfoValue}"
                                           Text="—"
                                           Margin="0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>

        <!-- ==================================================== -->
        <!--  BOTTOM BAR: download progress                       -->
        <!-- ==================================================== -->
        <materialDesign:Card Grid.Row="2"
                             Style="{StaticResource AppCard}"
                             Margin="0,16,0,0"
                             Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="DownloadProgressBar"
                             Grid.Column="0"
                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Height="8"
                             VerticalAlignment="Center"/>

                <TextBlock x:Name="ProgressPercentText"
                           Grid.Column="1"
                           Style="{StaticResource AppCaptionText}"
                           Text="0%"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
